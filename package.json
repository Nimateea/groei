{
  "name": "groei-browser",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4174",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "electron": "electron .",
    "desktop": "npm run build && GROEI_LOAD_DIST=1 electron .",
    "package:desktop": "npm run build && electron-builder",
    "start": "concurrently --kill-others \"npm:dev\" \"wait-on http://localhost:4174 && electron .\""
  },
  "dependencies": {
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "ai.groei.browser",
    "productName": "Groei Browser",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": ["AppImage"]
    },
    "mac": {
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    },
    "publish": {
      "provider": "github",
      "owner": "Nimateea",
      "repo": "groei"
    }
  }
}
